# Multi-stage build for Login microservice
FROM eclipse-temurin:17-jdk AS builder

# Install Maven
RUN apt-get update && apt-get install -y maven

# Set working directory
WORKDIR /app

# Copy just the login microservice files
COPY ./pom.xml ./
COPY ./src ./src

# Build just this service
RUN mvn clean package -DskipTests

# Runtime stage
FROM eclipse-temurin:17-jre

# Copy built JAR from builder stage
COPY --from=builder /app/target/login-microservice-0.0.1-SNAPSHOT.jar /app.jar

EXPOSE 8085

# Run with environment variable support
CMD ["java", "-jar", "/app.jar"]