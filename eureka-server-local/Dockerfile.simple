# Multi-stage build for Eureka server
FROM eclipse-temurin:17-jdk AS builder

# Install Maven
RUN apt-get update && apt-get install -y maven

# Set working directory
WORKDIR /app

# Copy just the eureka server files
COPY ./pom.xml ./
COPY ./src ./src

# Build just this service, skipping the docker-build execution
RUN mvn clean package -DskipTests -Dexec.skip

# Runtime stage
FROM eclipse-temurin:17-jre

# Copy built JAR from builder stage
COPY --from=builder /app/target/eureka-server-local-0.0.1-SNAPSHOT.jar /app.jar

EXPOSE 8761

# Run with environment variable support
CMD ["java", "-jar", "/app.jar"]